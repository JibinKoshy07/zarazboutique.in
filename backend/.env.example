# Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_NAME=zaraz
DB_PASSWORD=your_password_here
DB_PORT=5432

# Server Configuration
PORT=3000

# Secret used to sign session tokens (REQUIRED in production — use a long random string)
SESSION_SECRET=

# Comma-separated storefront origin(s) allowed to call the API cross-origin.
# Add your real domain(s) here for production, e.g. https://zarazboutique.in
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public origin of the API, used to build uploaded-image URLs (never trust Host header)
# e.g. https://api.zarazboutique.in  (defaults to http://localhost:PORT)
API_PUBLIC_URL=

# SMTP Configuration (for sending emails)
# Example for Gmail: Use App Password (not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Zaraz Boutique <your_email@gmail.com>

# Admin Configuration (auto-created on server start)
ADMIN_EMAIL=admin@zarazboutique.in
ADMIN_PASSWORD=SecureAdmin@123
ADMIN_NAME=Admin

# Admin Email (to receive order notifications)
ORDER_NOTIFICATION_EMAIL=admin@yourdomain.com

# Contact Form Email (to receive messages from the contact page form)
CONTACT_FORM_EMAIL=your_email@gmail.com

# Cashfree Payment Gateway (from Cashfree Dashboard > Developers > API Keys)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
# sandbox for testing, production for live payments
CASHFREE_ENV=sandbox
# Optional: webhook secret from Dashboard > Developers > Webhooks (defaults to CASHFREE_SECRET_KEY)
CASHFREE_WEBHOOK_SECRET=
# Optional: your site's public base URL (used for payment return url), e.g. https://zarazboutique.in
APP_BASE_URL=
