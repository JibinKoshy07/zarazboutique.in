# ---------------------------------------------------------------------------
# Zaraz Boutique - environment template
#
# Copy this file to `.env` and adjust the values, then run:
#   docker compose up -d --build
# ---------------------------------------------------------------------------

# --- Runtime ----------------------------------------------------------------
NODE_ENV=production
# Host ports published by Docker Compose.
WEB_PORT=8080
API_PORT_HOST=4000
DB_PORT_HOST=5432

# --- Database ---------------------------------------------------------------
# These credentials create the PostgreSQL role and database on first boot.
DB_NAME=zaraz
DB_USER=zaraz_user
DB_PASSWORD=change-me-in-production
DB_POOL_MAX=10

# --- Public URLs ------------------------------------------------------------
# Where browsers reach the site (used to build uploaded-image URLs).
API_PUBLIC_URL=http://localhost:8080
# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Auth -------------------------------------------------------------------
# REQUIRED. Generate with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- Seeded administrator (created on first boot) ---------------------------
ADMIN_EMAIL=admin@zarazboutique.in
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Store Admin
# Set to false once you have real data and do not want sample rows created.
SEED_ON_START=true
# Password for the seeded demo shopper (priya@example.com).
DEMO_CUSTOMER_PASSWORD=Customer@123

# --- Product image storage --------------------------------------------------
# 'local' stores uploads on disk (mounted as the `uploads-data` volume).
STORAGE_DRIVER=local
UPLOAD_MAX_MB=5

# --- Payments (gateway-ready, no live provider yet) -------------------------
# Only 'manual' (offline) is implemented today. To integrate a gateway later,
# register a provider in backend/src/services/payment/index.js and set this.
PAYMENT_PROVIDER=manual
PAYMENT_CURRENCY=INR
PAYMENT_COD_ENABLED=true
PAYMENT_UPI_ENABLED=true
PAYMENT_CARD_ENABLED=true
PAYMENT_UPI_VPA=zarazboutique@upi

# --- Storefront -------------------------------------------------------------
CONTACT_FORM_EMAIL=support@zarazboutique.in
# Shipping: set SHIPPING_FLAT_RATE to charge a fee, and SHIPPING_FREE_ABOVE to
# waive it above a subtotal. 0 / 0 means shipping is always free.
SHIPPING_FLAT_RATE=0
SHIPPING_FREE_ABOVE=0

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
